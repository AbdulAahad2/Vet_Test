<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- 1. REPORT ACTION -->
    <!-- ========================================================= -->
    <record id="action_report_visit_receipt" model="ir.actions.report">
        <field name="name">Visit Receipt (Thermal)</field>
        <field name="model">vet.animal.visit</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vet_test.report_visit_receipt</field>
        <field name="report_file">vet_test.report_visit_receipt</field>
        <field name="binding_model_id" ref="vet_test.model_vet_animal_visit"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ========================================================= -->
    <!-- 2. QWEB TEMPLATE – 80 mm -->
    <!-- ========================================================= -->
    <template id="report_visit_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="receipt">

                    <!-- ====================== HEADER ====================== -->
                    <div class="header">
                        <img t-att-src="image_data_uri(env.company.logo)" class="logo"/>
                        <div class="clinic">
                            <div class="name">Healthy Tails Animal Hospital</div>
                            <div class="email">healthytailsanimalhospital@gmail.com</div>
                            <div class="contact-line">Contact Shaheed-e-Millat: 0317-8221777</div>
                            <div class="contact-line">Contact Muslium: 0317-8221223</div>
                        </div>
                        <div class="dash">-----------------------------------------</div>
                        <div class="served">Served By: <t t-esc="env.user.name"/></div>
                        <div class="consulted">Consulted By: Dr. <t t-esc="doc.doctor_id.name or ''"/></div>
                        <div class="ticket"><t t-esc="doc.name"/></div>
                    </div>

                    <!-- ====================== ANIMAL / OWNER ====================== -->
                    <t t-if="doc.animal_id">
                        <div class="section">
                            <div class="animal">Animal: <t t-esc="doc.animal_id.name"/></div>
                            <t t-if="doc.animal_id.microchip_no">
                                <div class="microchip">ID: <t t-esc="doc.animal_id.microchip_no"/></div>
                            </t>
                        </div>
                    </t>

                    <t t-if="doc.owner_id">
                        <div class="section">
                            <div class="owner">Owner: <t t-esc="doc.owner_id.name"/></div>
                            <t t-if="doc.owner_id.contact_number">
                                <div class="phone">Phone: <t t-esc="doc.owner_id.contact_number"/></div>
                            </t>
                        </div>
                    </t>

                    <!-- ====================== ITEMS TABLE ====================== -->
                    <div class="items-section">
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th class="left">Item</th>
                                    <th class="center">Qty</th>
                                    <th class="right"> </th>
                                    <th class="right">Discount</th>
                                    <th class="right">Final</th>
                                    <th class="right"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Receipt lines -->
                                <t t-foreach="doc.receipt_lines" t-as="line">
                                    <t t-set="orig_price" t-value="line.service_id.product_id.lst_price"/>
                                    <t t-set="disc_amount" t-value="orig_price * (line.line_discount / 100)"/>
                                    <t t-set="final_price" t-value="orig_price - disc_amount"/>
                                    <tr>
                                        <td class="left"><t t-esc="line.product_id.display_name or line.service_id.name"/></td>
                                        <td class="center"><t t-esc="line.quantity"/>
                                        </td>
                                        <td class="right"><strong>
                                            <t t-esc="line.service_id.product_id.lst_price"/>
                                        </strong></td>
                                        <td class="right text-danger">
                                            <t t-if="line.line_discount &gt; 0">
                                                <span class="discount-tag"> (<t t-esc="line.line_discount"/>% off)</span>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="right"><strong>
                                            <t t-esc="line.subtotal"
                                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                                        </strong></td>
                                    </tr>
                                </t>

                                <!-- Treatment charge -->
                                <t t-if="doc.treatment_charge &gt; 0">
                                    <tr>
                                        <td class="left">Treatment Charge</td>
                                        <td class="center">1</td>
                                        <td class="right"></td>
                                        <td class="right"><strong>
                                            <t t-esc="doc.treatment_charge"
                                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                                        </strong></td>
                                        <td class="right"></td>
                                        <td class="right"><strong>
                                            <t t-esc="doc.treatment_charge"
                                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                                        </strong></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ====================== TOTALS ====================== -->
                    <div class="totals">
                        <div class="total-line">
                            Subtotal:
                            <t t-esc="doc.subtotal"
                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                        </div>

                        <t t-if="doc.discount_percent &gt; 0">
                            <div class="total-line discount">
                                Discount (<t t-esc="doc.discount_percent"/>%):
                                -<t t-esc="(doc.subtotal * doc.discount_percent / 100)"
                                     t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                            </div>
                        </t>

                        <t t-if="doc.discount_fixed &gt; 0">
                            <div class="total-line discount">
                                Discount (Fix):
                                -<t t-esc="doc.discount_fixed"
                                     t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                            </div>
                        </t>

                        <div class="total-line received">
                            Received:
                            <t t-esc="doc.amount_received"
                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                        </div>
                        <div class="grand">
                            TOTAL:
                            <t t-esc="doc.total_amount"
                               t-options='{"widget":"monetary","display_currency":env.company.currency_id}'/>
                        </div>
                    </div>

                    <!-- ====================== FOOTER ====================== -->
                    <div class="thanks">Thanks for Visiting!</div>
                    <div class="footer">
                        <div>Powered by Ermanager Consulting Services</div>
                        <div>Order <t t-esc="doc.name"/> | <span id="local-datetime-footer">Loading...</span></div>
                    </div>

                </div>
            </t>
        </t>

        <!-- ====================== CSS ====================== -->
        <style type="text/css" media="screen,print">
            @page { size: 80mm auto; margin: 0; }
            body { margin:0; padding:0; font-family:'DejaVu Sans Mono',monospace; font-size:12px; line-height:1.35; }
            .receipt { width:80mm; padding:2mm 3mm; }
            .logo { display:block; margin:0 auto 2mm; max-width:30mm; height:auto; }
            .clinic,.served,.consulted,.ticket,.section { text-align:center; }
            .clinic .name { font-weight:bold; font-size:13px; }
            .dash { margin:2mm 0; font-weight:bold; }
            .ticket { font-size:28px; font-weight:bold; margin:4mm 0; }
            .animal,.owner { font-size:14px; font-weight:bold; }
            .items-table { width:100%; border-collapse:collapse; font-size:11px; }
            .items-table th,.items-table td { padding:1mm 0; }
            .items-table th.left   { text-align:left; }
            .items-table th.center { text-align:center; }
            .items-table th.right  { text-align:right; }
            .items-table td.left   { text-align:left; }
            .items-table td.center { text-align:center; }
            .items-table td.right  { text-align:right; }
            .text-muted { color:#888; }
            .text-danger { color:#d00; }
            .discount-tag { color:#d00; font-weight:bold; font-size:10px; }
            .totals { margin-top:5mm; padding-top:4mm; border-top:2px solid #000; }
            .total-line { display:flex; justify-content:space-between; margin:2.5mm 0; font-size:16px; font-weight:bold; }
            .total-line.discount { color:#f57c00; }
            .total-line.received { color:#2e7d32; }
            .total-line.balance  { color:#d32f2f; }
            .grand { display:flex; justify-content:space-between; font-size:18px; font-weight:900;
                     border-top:2px double #000; padding-top:4mm; margin-top:4mm; }
            .thanks { text-align:center; font-weight:bold; margin:4mm 0 2mm; }
            .footer { margin-top:5mm; text-align:center; font-size:10px; }
            #local-datetime-footer { font-weight:bold; }
        </style>

        <!-- ====================== JS ====================== -->
        <script>
        //<![CDATA[
            document.addEventListener('DOMContentLoaded', () => {
                const now = new Date();
                const formatted = `${String(now.getMonth()+1).padStart(2,0)}/${String(now.getDate()).padStart(2,0)}/${now.getFullYear()} ${now.getHours()%12||12}:${String(now.getMinutes()).padStart(2,0)} ${now.getHours()>=12?'PM':'AM'}`;
                const el = document.getElementById('local-datetime-footer');
                if (el) el.textContent = formatted;
                setTimeout(() => window.print(), 300);
            });

            const close = () => window.close() || (window.location.href = 'about:blank');
            window.addEventListener('afterprint', close);

            let open = false;
            window.addEventListener('blur', () => open = true);
            window.addEventListener('focus', () => open && close());
        //]]>
        </script>
    </template>
</odoo>
